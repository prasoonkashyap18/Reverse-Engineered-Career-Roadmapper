# Server-side only. Never prefix with NEXT_PUBLIC_ and never import
# this value into a client component.

# Anthropic API key, used by lib/ai/providers/anthropic.ts to generate
# roadmaps (Step 4). Required for POST /api/roadmap/generate to succeed;
# without it, that route returns a 503 with a safe error message.
AI_API_KEY=

# Optional: override the default model (see lib/ai/providers/anthropic.ts).
AI_MODEL=
